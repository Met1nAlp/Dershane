# Supabase Postgres bağlantı adresleri (Project Settings → Database → Connect)
# DATABASE_URL: "Transaction pooler" (port 6543) — uygulama çalışma zamanında bunu kullanır
# DIRECT_URL:   "Direct connection" (port 5432) — sadece migration/CLI komutları için
DATABASE_URL=
DIRECT_URL=

# Admin oturum imzalama anahtarı (rastgele, uzun bir string — bir kere üretilir, değişmez)
SESSION_SECRET=

# İlk admin hesabı SADECE `npm run db:seed` ilk çalıştığında kullanılır ve AdminUser
# tablosuna yazılır; sonrasında admin panelinden değiştirilir, bu satırlar silinebilir.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Görsel yükleme (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# İletişim formu e-posta bildirimi (Resend)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
