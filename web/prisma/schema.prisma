generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ADMIN ───────────────────────────────────────────────────
// Tek admin hesabı — id her zaman 1, admin ayarları sayfasından
// kullanıcı adı/şifre güncellenebilir.
model AdminUser {
  id           Int      @id @default(1)
  username     String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
}

// ─── HERO ────────────────────────────────────────────────────
model HeroContent {
  id                Int      @id @default(1)
  badge             String
  headingLine1      String
  rotatingWords     String[]
  subtext           String
  primaryCtaLabel   String
  secondaryCtaLabel String
  updatedAt         DateTime @updatedAt
}

// Shared between Hero's stat row and the Stats section counters,
// so editing a number once updates it in both places.
model StatItem {
  id          Int     @id @default(autoincrement())
  order       Int     @default(0)
  icon        String
  value       Int
  prefix      String?
  suffix      String?
  label       String
  description String?
  showInHero  Boolean @default(false)
  showInStats Boolean @default(false)
}

model StatsSectionContent {
  id          Int    @id @default(1)
  badge       String
  titleLine1  String
  titleLine2  String
  description String
}

// ─── ABOUT ───────────────────────────────────────────────────
model AboutContent {
  id            Int    @id @default(1)
  badge         String
  titleLine1    String
  titleAccent   String
  description   String
  foundingYear  String
  foundingLabel String
  foundingSub   String
}

model AboutPillar {
  id          Int    @id @default(autoincrement())
  order       Int    @default(0)
  icon        String
  title       String
  description String
  highlight   String
}

// ─── SERVICES ────────────────────────────────────────────────
model ServicesSectionContent {
  id          Int    @id @default(1)
  badge       String
  title       String
  description String
}

model ServiceItem {
  id          Int    @id @default(autoincrement())
  order       Int    @default(0)
  icon        String
  title       String
  description String
}

// ─── PRACTICE (deneme ve soru cozumu) ───────────────────────
model PracticeSectionContent {
  id          Int    @id @default(1)
  badge       String
  title       String
  description String
}

model PracticeItem {
  id          Int    @id @default(autoincrement())
  order       Int    @default(0)
  title       String
  tag         String
  description String @default("")
  imageUrl    String
}

// ─── EVENTS ──────────────────────────────────────────────────
model EventsSectionContent {
  id          Int    @id @default(1)
  badge       String
  title       String
  description String
}

model EventItem {
  id          Int    @id @default(autoincrement())
  order       Int    @default(0)
  title       String
  tag         String
  // Akordiyon karti acildiginda gorunur; mevcut satirlar bos baslar.
  description String @default("")
  imageUrl    String
}

// ─── CONTACT ─────────────────────────────────────────────────
model ContactSectionContent {
  id                   Int    @id @default(1)
  badge                String
  title                String
  description          String
  infoAddressLabel     String
  infoPhoneLabel       String
  infoEmailLabel       String
  infoHoursLabel       String
  mapPlaceholderText   String
  formTitle            String
  formNameLabel        String
  formNamePlaceholder  String
  formPhoneLabel       String
  formPhonePlaceholder String
  formEmailLabel       String
  formEmailPlaceholder String
  formNoteLabel        String
  formNotePlaceholder  String
  submitLabel          String
  submitLoadingLabel   String
  successTitle         String
  successMessage       String
  successButtonLabel   String
  errorGeneric         String
  errorUnexpected      String
}

model ContactInfo {
  id           Int     @id @default(1)
  address      String
  phone        String
  email        String
  workingHours String
  mapEmbedUrl  String?
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  note      String?
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

// ─── NAVBAR / FOOTER ─────────────────────────────────────────
// NavLink hem Navbar menusu hem Footer link listesi tarafindan
// paylasilir — tek kaynak, ikisi arasinda tutarsizlik olmaz.
model NavLink {
  id    Int    @id @default(autoincrement())
  order Int    @default(0)
  label String
  href  String
}

model NavbarContent {
  id       Int    @id @default(1)
  ctaLabel String
}

model FooterContent {
  id              Int    @id @default(1)
  copyrightSuffix String
  creditLine      String
}

// ─── SITE SETTINGS ───────────────────────────────────────────
model SiteSettings {
  id           Int    @id @default(1)
  brandName    String
  brandTagline String
}

model SocialLink {
  id       Int    @id @default(autoincrement())
  order    Int    @default(0)
  platform String
  url      String
}
